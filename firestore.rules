rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Current-session log: one document per dough type, overwritten on each confirm.
    // Shared across the bakery team (any authenticated client reads the same log).
    // NOTE: with Anonymous Auth this means any authenticated client can read it.
    // True per-bakery isolation requires real (non-anonymous) auth — tracked as the
    // next security step; this ruleset only hardens validation, not read scope.
    match /log/{dough} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && dough in ['focaccia', 'brioche', 'sourdough']
        && request.resource.data.keys().hasOnly(['dough', 'date', 'time', 'text'])
        && request.resource.data.dough is string
        && request.resource.data.dough in ['Focaccia', 'Brioche', 'Sourdough']
        && request.resource.data.date is string
        && request.resource.data.date.size() < 50
        && request.resource.data.time is string
        && request.resource.data.time.size() < 10
        && request.resource.data.text is string
        && request.resource.data.text.size() < 2000;

      allow delete: if request.auth != null
        && dough in ['focaccia', 'brioche', 'sourdough'];
    }

    // Daily production log: one document per day (YYYY-MM-DD), keyed by dough type.
    // saveDailyEntry() merges one dough sub-entry at a time, so request.resource.data
    // is the full merged document — its top-level keys must be a subset of the three
    // dough types, and each present sub-entry must be a map. The app never deletes
    // daily logs, so delete is denied.
    match /daily-logs/{date} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['focaccia', 'brioche', 'sourdough'])
        && request.resource.data.keys().size() > 0
        && (!('focaccia' in request.resource.data) || request.resource.data.focaccia is map)
        && (!('brioche' in request.resource.data) || request.resource.data.brioche is map)
        && (!('sourdough' in request.resource.data) || request.resource.data.sourdough is map);

      allow delete: if false;
    }

    // ── Orders system ─────────────────────────────────────────────────────────
    // Every document carries bakery == 'main' (forward-compatible with future
    // per-bakery isolation). Shared across the team under Anonymous Auth, exactly
    // like log/daily-logs.
    //
    // ⚠️ HOW A DOCUMENT IS WRITTEN DECIDES WHAT MAY BE REQUIRED:
    //
    //   * suppliers, ingredients and drafts are written with setDoc(merge: true)
    //     and updateDoc (firebase-orders.js saveDoc / clearFields). On an update,
    //     request.resource.data is the FULL MERGED document, not the patch. So
    //     keys().hasOnly() is checked against the WHOLE stored document — every
    //     field a live document was ever given must be listed, retired ones
    //     included — and NO field may be required, because a partial write (just
    //     { active } from Deactivate, or one deleteField path from clearSupplier)
    //     merges onto a document that may predate that field.
    //
    //   * orders-history is only ever written WHOLE (transactDoc's tx.set and
    //     replaceDoc, both setDoc WITHOUT merge). The payload is fully determined
    //     by today's code, so hasOnly is exact AND the fields can be required.
    //
    // Requiring a field on a merged collection is what would silently brick a live
    // document. Every key list below was verified against PRODUCTION on 24 Jul 2026
    // (6 suppliers, 65 ingredients, drafts/current, 21 orders-history records), not
    // inferred — the retired fields really are still there.
    //
    // rules v2 cannot iterate a list or a map, so list ELEMENTS and map VALUES stay
    // client-side. What is enforced here is type and SIZE, which is what bounds a
    // junk-stuffed write.

    match /suppliers/{id} {
      allow read: if request.auth != null;

      // Written by the management panel: the whole form, or just { active } from
      // Deactivate/Activate. Both merge, so both are seen here as the complete
      // document.
      //
      // `notifyHoursBefore` is RETIRED (dropped 6 Jul 2026, commit 4fc3658) but was
      // never removed from the documents that carry it — a merge write never deletes
      // a field, and it is CONFIRMED still present in production. It may be null (the
      // old form wrote null for an empty box). The same commit ADDED orderDays, so a
      // supplier untouched since has the old field and lacks the new one: that is why
      // nothing here is required. Delete it from production and this entry can go;
      // remove it before that and every old supplier stops being writable.
      allow create, update: if request.auth != null
        && request.resource.data.bakery == 'main'
        && request.resource.data.keys().hasOnly([
             'bakery', 'name', 'category', 'phone', 'email',
             'deliveryDays', 'orderDays', 'active', 'notifyHoursBefore'
           ])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 200))
        && (!('category' in request.resource.data)
            || (request.resource.data.category is string
                && request.resource.data.category.size() <= 200))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 40))
        && (!('email' in request.resource.data)
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 320))
        && (!('deliveryDays' in request.resource.data)
            || (request.resource.data.deliveryDays is list
                && request.resource.data.deliveryDays.size() <= 7))
        && (!('orderDays' in request.resource.data)
            || (request.resource.data.orderDays is list
                && request.resource.data.orderDays.size() <= 7))
        && (!('active' in request.resource.data)
            || request.resource.data.active is bool)
        && (!('notifyHoursBefore' in request.resource.data)
            || request.resource.data.notifyHoursBefore == null
            || request.resource.data.notifyHoursBefore is number);

      // Permanent delete from the management panel (a strong confirm gates it in
      // the UI). "Deactivate" (active:false) remains the reversible option.
      allow delete: if request.auth != null;
    }

    match /ingredients/{id} {
      allow read: if request.auth != null;

      // The whole form, or just { active } from Deactivate/Activate. Both merge.
      //
      // `brand` and `weight` only arrived in v1.10.0 (18 Jul 2026) and `unit` changed
      // MEANING there (the order unit, e.g. "casse") rather than shape. An ingredient
      // not edited since is missing brand/weight, so none of these may be required —
      // otherwise its Deactivate toggle stops working.
      allow create, update: if request.auth != null
        && request.resource.data.bakery == 'main'
        && request.resource.data.keys().hasOnly([
             'bakery', 'name', 'supplierId', 'brand', 'weight',
             'category', 'unit', 'active'
           ])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 200))
        && (!('supplierId' in request.resource.data)
            || (request.resource.data.supplierId is string
                && request.resource.data.supplierId.size() <= 200))
        && (!('brand' in request.resource.data)
            || (request.resource.data.brand is string
                && request.resource.data.brand.size() <= 200))
        && (!('weight' in request.resource.data)
            || (request.resource.data.weight is string
                && request.resource.data.weight.size() <= 100))
        && (!('category' in request.resource.data)
            || (request.resource.data.category is string
                && request.resource.data.category.size() <= 200))
        && (!('unit' in request.resource.data)
            || (request.resource.data.unit is string
                && request.resource.data.unit.size() <= 100))
        && (!('active' in request.resource.data)
            || request.resource.data.active is bool);

      allow delete: if request.auth != null;
    }

    // The order in progress: ONE document, drafts/current, rewritten on every
    // keystroke (merge) and surgically cleared per supplier (updateDoc with
    // deleteField on 'entries.<id>' / 'days.<supplierId>'). Both are merges, so
    // nothing may be required.
    //
    // `weekId` is RETIRED — the pre-v179 weekly saveDraftNow wrote it, and nothing
    // has ever removed it: the old clearDraft() that deleted the document is gone,
    // and clearFields only touches entries.*/days.*. CONFIRMED still present in
    // production, so it is listed here; without it the autosave would be refused on
    // every keystroke. Delete the field (or the whole document, from the console,
    // while the draft is empty) and this entry can go.
    //
    // Delete is now DENIED: since v179 nothing in the app deletes the draft —
    // clearSupplier removes only that supplier's keys. Allowing it only left a way
    // to wipe an order in progress, and clearFields uses updateDoc, which would then
    // fail on a missing document.
    match /drafts/{id} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && id == 'current'
        && request.resource.data.bakery == 'main'
        && request.resource.data.keys().hasOnly([
             'bakery', 'entries', 'days', 'updatedAt', 'weekId'
           ])
        && (!('entries' in request.resource.data)
            || (request.resource.data.entries is map
                && request.resource.data.entries.size() <= 2000))
        && (!('days' in request.resource.data)
            || (request.resource.data.days is map
                && request.resource.data.days.size() <= 200))
        && (!('updatedAt' in request.resource.data)
            || (request.resource.data.updatedAt is string
                && request.resource.data.updatedAt.size() <= 64))
        && (!('weekId' in request.resource.data)
            || (request.resource.data.weekId is string
                && request.resource.data.weekId.size() <= 32));

      allow delete: if false;
    }

    // One document per DAY per SUPPLIER, id "YYYY-MM-DD_<supplierId>". Delete is
    // allowed: a second order to the same supplier on the same day ADDS to the
    // first, which is only safe if a mistaken record can be corrected or removed
    // (the History editor). The UI gates it behind a named, red confirmation.
    //
    // Two allow statements — Firestore ORs them. The document id decides which
    // applies, so a record of the current model can never be written in the old
    // shape, and the one legacy document stays editable without loosening anything
    // for new records.
    match /orders-history/{id} {
      allow read: if request.auth != null;

      // CURRENT MODEL. Always written WHOLE (tx.set / replaceDoc), so hasOnly is
      // exact and every field can be required.
      //
      // `id` is deliberately NOT in the key list: history-edit.js must not write the
      // document id back as a field. watchCollection injects `id` into every record
      // it hands out, and spreading that record into the payload put a redundant
      // top-level `id` into the document (fixed in js/orders/history-edit.js). A
      // record written before that fix may still carry one, which is harmless — every
      // write here is a full overwrite, so the next save drops it.
      allow create, update: if request.auth != null
        && request.resource.data.bakery == 'main'
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_.+$')
        && request.resource.data.keys().hasOnly([
             'bakery', 'date', 'supplierId', 'supplierName',
             'quantities', 'stock', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.supplierId is string
        && request.resource.data.supplierId.size() > 0
        && request.resource.data.supplierId.size() <= 200
        && request.resource.data.supplierName is string
        && request.resource.data.supplierName.size() <= 200
        && request.resource.data.quantities is map
        && request.resource.data.quantities.size() <= 500
        && request.resource.data.stock is map
        && request.resource.data.stock.size() <= 500
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 64
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 64;

      // LEGACY MODEL — the retired weekly archive: one document per ISO week
      // (orders-history/2026-W28), every supplier merged, `weekStart` (the Monday,
      // "YYYY-MM-DD") instead of `date`, and no supplierId/supplierName/updatedAt
      // until the History editor first touches it. Exactly one such document exists
      // in production; it is still read, still counted by the suggestion engine and
      // still editable, so its shape has to stay writable.
      //
      // Confined to ids that are NOT of the current model, so this branch can never
      // be used to slip a weekly-shaped document in among the daily ones. `date` is
      // pre-authorised for the planned backfill (bounding the history read with
      // orderBy('date','desc') + limit) so that needs no second rules deploy.
      allow create, update: if request.auth != null
        && request.resource.data.bakery == 'main'
        && !id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_.+$')
        && request.resource.data.keys().hasOnly([
             'bakery', 'weekStart', 'date', 'quantities',
             'stock', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.weekStart is string
        && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('date' in request.resource.data)
            || (request.resource.data.date is string
                && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.quantities is map
        && request.resource.data.quantities.size() <= 500
        && request.resource.data.stock is map
        && request.resource.data.stock.size() <= 500
        && (!('createdAt' in request.resource.data)
            || (request.resource.data.createdAt is string
                && request.resource.data.createdAt.size() <= 64))
        && (!('updatedAt' in request.resource.data)
            || (request.resource.data.updatedAt is string
                && request.resource.data.updatedAt.size() <= 64));

      allow delete: if request.auth != null;
    }

    // Calculator configuration: a single shared document (config/calculator)
    // holding the configurable clients, products and per-client unit weights for
    // the dough tabs (+ the market order). Shared across the team under Anonymous
    // Auth, like the log. bakery == 'main' is required on write, as elsewhere.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.bakery == 'main';
      allow delete: if false;
    }

    // Production logs (new model): each log is its own document logs/{id} with an
    // append-only version chain INSIDE the document (see js/log-model.js). Replaces
    // the old one-doc-per-dough `log` collection above (kept for migration reads).
    // Delete is allowed here — unlike history-keeping collections — because the
    // append-only history lives inside the document, so a delete is the user
    // explicitly removing a whole log (confirmed in the UI). Editing only ever
    // appends a version; it never deletes one.
    match /logs/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.bakery == 'main'
        && request.resource.data.dough is string
        && request.resource.data.versions is list;
      allow delete: if request.auth != null;
    }

    // Recipe catalogue: one document per recipe (recipes/{id}), the shared library
    // the catalogue reads/writes and the Calculator imports from. Editable and
    // deletable (an add/edit/delete catalogue), so delete is allowed. Payload is
    // validated for a non-empty name and a list of ingredients; per-gram numeric
    // checks stay client-side (rules v2 cannot iterate a list). bakery == 'main'
    // as elsewhere.
    match /recipes/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['bakery', 'name', 'ingredients'])
        && request.resource.data.bakery == 'main'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() <= 300;
      allow delete: if request.auth != null;
    }

    // Default deny: any collection not explicitly matched above is locked down,
    // so adding a new collection can never accidentally inherit open access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
