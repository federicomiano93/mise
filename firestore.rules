rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // THE LOCATION TREE — locations/{lid}/<collection>/{id}
    // ═══════════════════════════════════════════════════════════════════════
    //
    // Every document a location owns lives inside its own folder, and only the
    // people listed in users/{uid} can open that folder.
    //
    // ⚠️ THIS IS THE RULESET THAT CLOSES THE DOOR. Until it is deployed, anyone
    // who knew the public address was "authenticated" (the app signed itself in
    // anonymously) and could read and delete everything. Deploy it only AFTER the
    // app that signs people in is live, or the running app locks itself out.
    //
    // Three separate decisions, kept separate on purpose:
    //   member(lid)     — may this account open this location at all?
    //   sectionOn(lid)  — was this location set up with this part of the app?
    //   the field rules — is this particular document well formed?
    //
    // Only the first is a boundary between two businesses. The field validation is
    // ported verbatim from the collections as they were before the move, including
    // the retired fields, because removing one makes live documents permanently
    // unwritable. `bakery` must equal the location folder the document sits in,
    // so the field and the path can never disagree.

    function signedIn() {
      return request.auth != null;
    }

    // The document payload must be stamped with the folder it is being written to.
    function stampedFor(lid) {
      return request.resource.data.bakery == lid;
    }

    // ── Who may enter a location ──────────────────────────────────────────
    // users/{uid} lists the locations an account may open. It is readable only
    // by that account and writable by NOBODY through the app — the Firebase
    // console is the only way in. That single fact is what makes this a boundary
    // rather than a preference: no client can grant itself access to a
    // location, whatever it sends.
    //
    // A missing users document therefore means NO access, never "all of them".
    // The .get() form with a default is used so that a missing field denies
    // quietly instead of erroring.
    // ⚠️ THE VALUE CARRIES THE ROLE: `true` is ordinary staff, 'owner' is the
    // person whose business it is. Anything else — false, missing, a typo, a
    // value from a future version — is no access at all. The `in [...]` form is
    // used rather than two comparisons so a boolean is never compared with a
    // string, and so the document is read once.
    //
    // `true` MEANS STAFF ON PURPOSE. Every membership in production is written
    // `true` today, so this ruleset takes nobody's access away on the day it
    // lands; the accounts that should hold owner powers get them from a backfill
    // that turns their `true` into 'owner'. js/sections.js reads the same value
    // the same way, and js/roles.js turns it into a role.
    function member(lid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('locations', {}).get(lid, false) in [true, 'manager', 'owner'];
    }

    // ── Which parts of the app a location uses ────────────────────────────
    // The OPPOSITE default to membership, deliberately: a missing location
    // document, or a missing `sections` field, leaves every section ON. This is
    // not a boundary between locations (a location only ever sees its own
    // data either way) — it decides which screens a location was set up with,
    // and a forgotten field must not empty the app of a business that is working.
    function sectionOn(lid, name) {
      return !exists(/databases/$(database)/documents/locations/$(lid))
        || get(/databases/$(database)/documents/locations/$(lid))
             .data.get('sections', {}).get(name, true) != false;
    }

    function canUse(lid, section) {
      return member(lid) && sectionOn(lid, section);
    }

    // ── What a person may do once they are INSIDE a location ──────────────
    // member(lid) is the boundary between two businesses. This is the smaller
    // boundary between two people in the same business, and it exists because
    // the app is going to be sold: with one owner's own two venues, everybody
    // being able to delete everything is a shrug; with a paying customer it is
    // their counter staff emptying their supplier list.
    //
    // ⚠️ THE DEFAULT IS 'staff', AND IT HAS TO BE. Every users document written
    // before today has no `roles` field at all, so a default of 'owner' would
    // make the whole thing decorative — and any account whose role write was
    // lost would silently hold another business's delete buttons. Power nobody
    // granted does not exist. js/roles.js carries the same default, deliberately
    // identical, and does NOT forgive a stray space in a key because this does
    // not forgive one either.
    //
    // ⚠️ THE CONSEQUENCE, AND IT IS THE RISKY MOMENT OF THIS CHANGE: the
    // accounts that exist today must have `roles` written BEFORE this ruleset is
    // deployed, or their owners lose their own delete buttons. Read the backfill
    // back from the API afterwards — a trailing space is invisible in the
    // console, and that has already cost this project half an hour once.
    //
    // The exists() guard makes this safe to call on its own. It is not strictly
    // needed while every call site goes through canUse() first (&& short-circuits,
    // so member() has already proved the document is there), but a helper that
    // errors depending on where it is called from is a trap for the next person.
    // Firestore charges one access per document per evaluation, so it is free.
    // ⚠️ IT DOES NOT USE THE `.get('roles', {}).get(...)` SHAPE member() USES ONE
    // SCREEN UP, and the difference is not style. Calling .get() on the `{}`
    // DEFAULT is an evaluation error, not a miss — the rule throws instead of
    // answering. member() never meets it because every users document has a
    // `locations` field; roleIn() meets it on EVERY account in the database
    // today, because none of them has `roles` yet. Written the short way, all
    // seven gated rules below threw on the accounts they most needed to answer
    // for. (member() carries the same latent trap for a document with no
    // `locations`; it is left alone because it fails towards deny, which is the
    // safe direction there.)
    //
    // Asking `is map` as well is what makes a corrupt `roles` resolve to 'staff'
    // instead of throwing, which is exactly what js/roles.js does with the same
    // input. The two must agree, so they agree here too.
    // ⚠️⚠️ THIS READS users/{uid} EXACTLY ONCE, AND THAT IS THE WHOLE REASON IT
    // IS SHAPED LIKE THIS. The obvious version — canUse(lid, section) && a
    // roleIn(lid) helper that fetches the document itself — is correct, readable,
    // and DOES NOT WORK. Firestore allows 10 document accesses per request, and
    // when an `allow` evaluates FALSE the engine carries on to the next matching
    // rule and evaluates again, so every access is paid TWICE: member()'s
    // exists+get, sectionOn()'s exists+get and roleIn()'s get come to 5, and 5
    // doubled is the limit exactly.
    //
    // The failure is vicious because it is invisible from the owner's side: the
    // owner's rule returns TRUE, evaluation stops at the first pass, and the
    // budget is never exceeded. Only a STAFF member — the one person this whole
    // change exists for — pushes it to a second pass, and what they get is not a
    // clean refusal but an evaluation error. It denies, so the app behaves
    // correctly by accident, and nothing anywhere says why.
    //
    // Found by a check that insists a denial is an ANSWER and not a crash
    // (expectDeniedCleanly), after three wrong hypotheses. Do not "tidy" this
    // back into two helpers: it reads worse and works.
    function roleIn(lid) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('locations', {}).get(lid, false);
    }

    // ⚠️ THE `is string` GUARD IS DELIBERATE. This value is a BOOLEAN for an
    // ordinary employee (`true`) and a STRING for the two upper roles, and the
    // rules language is strongly typed — comparing a boolean with a string is a
    // type error rather than `false`. Asking the type first keeps the comparison
    // honest whatever is in the document, including whatever a future version
    // decides to store here.
    function runsThePlace(value) {
      return value is string && (value == 'owner' || value == 'manager');
    }

    // ⚠️ IT IS canManage AND NOT isOwner, AND THE NAME MATTERS. There are three
    // roles (js/roles.js): the owner, the manager who runs one location, and the
    // ordinary employee. Everything an owner may do INSIDE a location, a manager
    // may do too — deleting included. What separates them is hiring, and hiring
    // never touches these rules: memberships and join codes are `allow write: if
    // false` and are written only by functions/onboarding.js, which asks for the
    // owner itself. So the rules need only two tiers, not three.
    //
    // ⚠️ IT TAKES THE SECTION TOO, so a manager of a location that does not use
    // Orders still cannot delete a supplier. A role narrows what membership and
    // sections already granted; it can never widen either of them.
    function canManage(lid, section) {
      return canUse(lid, section) && runsThePlace(roleIn(lid));
    }

    // ── Where the line is drawn, and what is deliberately NOT behind it ────
    //
    // The test is "does deleting this take away work that is not yours". So
    // canManage() guards: suppliers, ingredients, recipes, products, and the
    // client-ordering accounts and menus (creating one hands an outsider a way
    // in; deleting one cuts off a customer's phone).
    //
    // These five stay open to anybody in the location, ON PURPOSE — they are how
    // a person corrects their OWN work, and a baker who cannot fix a mistyped
    // log at 5am will simply stop recording things:
    //     logs/{id} · log/{dough} · orders-history/{id}
    //     client-orders/{id} · pastry-logs/{id}
    //
    // ⚠️ AND `config/{doc}` IS DELIBERATELY NOT GATED, though it looks like the
    // obvious candidate. config/calculator is not a settings document: it holds
    // the whole address book, every client's products AND every recipe the
    // Calculator owns. Gating it would stop a baker editing a recipe — the most
    // ordinary act in this app — to protect a few settings that sit in the same
    // document by history. Splitting that document is its own piece of work; a
    // rule that breaks daily work is not a safer rule.
    //
    // Deleting is what earns the gate because deleting is what cannot be undone.
    // Changing a setting is visible and reversible; a deleted supplier is not.

    // ── Who may order AS a client ─────────────────────────────────────────
    // A wholesale client types its own order into the app instead of sending it on
    // WhatsApp, so for the first time an account belonging to somebody OUTSIDE the
    // business can reach this database. Everything below exists to make that account
    // able to do exactly two things and nothing else: read its own product list, and
    // write its own order.
    //
    // ⚠️ THE GRANT LIVES INSIDE THE LOCATION, NOT IN users/{uid}, AND THE DIFFERENCE
    // IS DELIBERATE. Membership is the boundary between two businesses, so it is
    // console-only: no client may hand itself a location. This grant is smaller — it
    // lets a location share ONE of its own client's product lists with that client —
    // so it may be given by the people who already hold all of that location's data.
    //
    // The alternative was to let a member write another person's users/{uid}. That
    // one rule would have been a master key to the whole database, across every
    // location, for ever. This shape cannot do that: a client-accounts document
    // grants strictly LESS than the member writing it already has, and only inside
    // their own location.
    //
    // ⚠️ AN ORDERING ACCOUNT IS NEVER A member(). It has no users/{uid} document at
    // all, so every rule written for staff refuses it by default rather than by
    // remembering to ask. That is the property to preserve: safety here comes from
    // the ordering account being invisible to the staff rules, not from those rules
    // each carrying an exception.
    //
    // A missing document, a missing field or an empty value all mean "no client at
    // all" — the same deny-by-default as membership, for the same reason.
    function orderClientOf(lid) {
      return exists(/databases/$(database)/documents/locations/$(lid)/client-accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/locations/$(lid)/client-accounts/$(request.auth.uid))
            .data.get('clientId', '')
        : '';
    }

    function isOrderClient(lid, clientId) {
      return signedIn()
        && clientId is string
        && clientId != ''
        && orderClientOf(lid) == clientId;
    }

    // ── Who may READ Orders' address book ─────────────────────────────────
    // Ingredients and suppliers belong to Orders and are still written only from
    // Orders, but they are no longer read only there: the Recipe catalogue links a
    // recipe row to an ingredient so it can cost it, and the chooser names the
    // supplier so two similar articles can be told apart. Reading is widened;
    // WRITING deliberately is not.
    //
    // ⚠️ ADDING A NAME HERE IS ONLY SAFE ONCE THAT SECTION CAN BE TURNED OFF.
    // sectionOn() defaults to TRUE for a section no location document mentions, so
    // a name in this OR that no venue has explicitly disabled makes the whole
    // condition always true and the read stops being gated at all. 'foodcost'
    // joins the list in the release that CREATES the section, and that release
    // requires `sections.foodcost: false` to be typed into every venue that must
    // not have it BEFORE the rules deploy. Same trap, same fix, as the note in
    // js/sections.js.
    function canReadOrdersData(lid) {
      return member(lid)
        && (sectionOn(lid, 'orders')
            || sectionOn(lid, 'catalogue')
            || sectionOn(lid, 'foodcost'));
    }

    // Which locations an account may open. Readable only by that account, so
    // one person cannot enumerate another's access; writable by no client at all.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── The three collections only the server may touch ───────────────────
    //
    // All three would be denied anyway by the default-deny at the foot of this
    // file. They are written out because a collection that is invisible in the
    // rules is one nobody reviews, and each of these is load-bearing:
    //
    //   admins/{uid}      who may create a new customer's location. One document,
    //                     typed once in the console. If a client could WRITE this
    //                     it could make itself the app's administrator.
    //                     ⚠️ READING YOUR OWN IS ALLOWED, and only your own. The
    //                     app has to know whether to draw the "New customer" entry
    //                     at all; without this it could only find out by CALLING
    //                     createWorkspace and being refused, which means either
    //                     showing everybody a door that opens for one person, or
    //                     hiding it from the one person who needs it. Reading
    //                     cannot grant anything — the function checks the same
    //                     document server-side and never trusts this. It is the
    //                     same shape as users/{uid}: read your own, write never,
    //                     and no client may LIST the collection, so nobody can
    //                     discover who the administrators are.
    //
    //   join-codes/{id}   the id is a sha256 of the code, so the code itself is
    //                     never written down. ⚠️ IF THIS WERE READABLE, SIX DIGITS
    //                     WOULD BE WORTHLESS — anyone could list the collection
    //                     and read which location each code opens. Not listable,
    //                     not readable, not writable, by anybody.
    //
    //   rate-limits/{uid} how many redemption attempts an account has made in the
    //                     last hour. ⚠️ IT IS THE ACCOUNT'S OWN DOCUMENT AND IT
    //                     STILL MAY NOT WRITE IT — a limit somebody can reset is
    //                     not a limit, and this is the one thing standing between
    //                     a million combinations and an afternoon.
    match /admins/{uid}        { allow read: if signedIn() && request.auth.uid == uid;
                                 allow write: if false; }
    match /join-codes/{codeId} { allow read, write: if false; }
    match /rate-limits/{uid}   { allow read, write: if false; }

    match /locations/{lid} {

      // The location's own document: its display name and which sections of the
      // app it uses. Written ONLY from the Firebase console — an app that could
      // write this could rename a location or hand itself a section.
      allow read: if member(lid);
      allow write: if false;

      // ── Who works here ──────────────────────────────────────────────────
      //
      // The roster behind the "Who can get in" screen: one document per person,
      // with their email and role. Readable by anybody in the location — you
      // should be able to see who your colleagues are — and writable by NO
      // client, because the functions write it in the same transaction as the
      // membership itself.
      //
      // ⚠️ IT IS A COPY OF A FACT, AND THE COPY IS NOT THE ONE THAT DECIDES.
      // The truth is users/{uid}.locations, which is what member() and canManage()
      // read; this exists only because that document is readable solely by its
      // owner, so an owner could otherwise never list their own staff. Nothing
      // in this file consults it to decide anything, and nothing ever should —
      // the moment it does, the roster becomes a second place to grant access.
      match /members/{uid} {
        allow read: if member(lid);
        allow write: if false;
      }

      // ── Production logs (current model) ─────────────────────────────────
      // Written WHOLE (saveLogDoc uses setDoc with no merge), so the keys can be
      // listed exactly and the two the app always writes can be required.
      //
      // ⚠️ The cap on `versions` is the point of this block, not tidiness. The
      // chain is append-only by design — every edit adds one and nothing ever
      // removes one — and a Firestore document dies at 1MB. Without a limit a
      // heavily corrected log would eventually refuse every further write, with
      // nothing on screen to explain why. 100 versions is far past any real use
      // and still nowhere near the ceiling.
      match /logs/{id} {
        allow read: if canUse(lid, 'calculator');
        allow create, update: if canUse(lid, 'calculator')
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly([
               'bakery', 'id', 'dough', 'recipeId', 'forDay',
               'origin', 'createdAtMs', 'versions'
             ])
          && request.resource.data.dough is string
          && request.resource.data.dough.size() <= 200
          && request.resource.data.versions is list
          && request.resource.data.versions.size() <= 100
          && (!('id' in request.resource.data)
              || (request.resource.data.id is string
                  && request.resource.data.id.size() <= 200))
          && (!('recipeId' in request.resource.data)
              || (request.resource.data.recipeId is string
                  && request.resource.data.recipeId.size() <= 200))
          && (!('forDay' in request.resource.data)
              || request.resource.data.forDay in ['today', 'tomorrow'])
          && (!('origin' in request.resource.data)
              || request.resource.data.origin in ['calculator', 'manual'])
          && (!('createdAtMs' in request.resource.data)
              || request.resource.data.createdAtMs is number);
        allow delete: if canUse(lid, 'calculator');
      }

      // ── Production logs (legacy: one document per dough) ────────────────
      match /log/{dough} {
        allow read: if canUse(lid, 'calculator');

        allow write: if canUse(lid, 'calculator')
          && dough in ['focaccia', 'brioche', 'sourdough']
          && request.resource.data.keys().hasOnly(['dough', 'date', 'time', 'text'])
          && request.resource.data.dough is string
          && request.resource.data.dough in ['Focaccia', 'Brioche', 'Sourdough']
          && request.resource.data.date is string
          && request.resource.data.date.size() < 50
          && request.resource.data.time is string
          && request.resource.data.time.size() < 10
          && request.resource.data.text is string
          && request.resource.data.text.size() < 2000;

        allow delete: if canUse(lid, 'calculator')
          && dough in ['focaccia', 'brioche', 'sourdough'];
      }

      // ── Daily production log: one document per day, keyed by dough ───────
      match /daily-logs/{date} {
        allow read: if canUse(lid, 'calculator');

        allow create, update: if canUse(lid, 'calculator')
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['focaccia', 'brioche', 'sourdough'])
          && request.resource.data.keys().size() > 0
          && (!('focaccia' in request.resource.data) || request.resource.data.focaccia is map)
          && (!('brioche' in request.resource.data) || request.resource.data.brioche is map)
          && (!('sourdough' in request.resource.data) || request.resource.data.sourdough is map);

        allow delete: if false;
      }

      // ── Suppliers ───────────────────────────────────────────────────────
      // Written with setDoc(merge) — request.resource.data is the FULL MERGED
      // document, so every field a live document was ever given must be listed
      // and NOTHING may be required. `notifyHoursBefore` is retired but still
      // present in production; removing it here stops every old supplier from
      // being writable, silently and permanently.
      match /suppliers/{id} {
        allow read: if canReadOrdersData(lid);

        allow create, update: if canUse(lid, 'orders')
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly([
               'bakery', 'name', 'category', 'phone', 'email',
               'deliveryDays', 'orderDays', 'active', 'notifyHoursBefore'
             ])
          && (!('name' in request.resource.data)
              || (request.resource.data.name is string
                  && request.resource.data.name.size() <= 200))
          && (!('category' in request.resource.data)
              || (request.resource.data.category is string
                  && request.resource.data.category.size() <= 200))
          && (!('phone' in request.resource.data)
              || (request.resource.data.phone is string
                  && request.resource.data.phone.size() <= 40))
          && (!('email' in request.resource.data)
              || (request.resource.data.email is string
                  && request.resource.data.email.size() <= 320))
          && (!('deliveryDays' in request.resource.data)
              || (request.resource.data.deliveryDays is list
                  && request.resource.data.deliveryDays.size() <= 7))
          && (!('orderDays' in request.resource.data)
              || (request.resource.data.orderDays is list
                  && request.resource.data.orderDays.size() <= 7))
          && (!('active' in request.resource.data)
              || request.resource.data.active is bool)
          && (!('notifyHoursBefore' in request.resource.data)
              || request.resource.data.notifyHoursBefore == null
              || request.resource.data.notifyHoursBefore is number);

        // OWNER ONLY. Every ingredient filed under this supplier stops being
        // orderable the moment it goes, and every past order that named it
        // loses its heading. Nobody's own work; everybody's.
        allow delete: if canManage(lid, 'orders');
      }

      // ── Ingredients ─────────────────────────────────────────────────────
      // Also merge-written: brand/weight only arrived in v1.10.0, so an
      // ingredient untouched since then lacks them and nothing may be required.
      //
      // ⚠️ THE PRICE FIELDS MUST ALL ACCEPT null AS WELL AS A NUMBER. Clearing a
      // price is a merge write that sets them to null — a merge leaves out what
      // it does not mention, so "clear" cannot be expressed by omission. Refuse
      // null here and a price could be entered but never removed.
      //
      // `unit` (the ORDER unit: casse, box) and `priceUnit` (what the price is
      // quoted per: kg, l, pcs) are different fields with confusingly similar
      // names. The first is how you count the order, the second is how you buy it.
      //
      // ⚠️ `packPrice` and `packSize` ARE RETIRED and stay whitelisted. The rate
      // used to be derived from them; it is typed now, and every save sets them
      // to null so they drain out of production. Take them out of this list
      // before production has stopped carrying them and every affected ingredient
      // becomes permanently unwritable — the same trap already documented for
      // `notifyHoursBefore` and `weekId`.
      // ── What an ingredient COSTS, kept away from what it IS ──────────────
      //
      // ⚠️⚠️ IT IS A SEPARATE COLLECTION BECAUSE ORDERS MUST READ EVERY
      // INGREDIENT. That is the order screen — names, suppliers, categories — so a
      // rate written on the ingredient document is a rate every person in the
      // building can read, whatever the Food Cost screen does. Closing Food Cost
      // hid the MARGIN and left "what a sack of flour costs" in plain view.
      //
      // ⚠️ A PARALLEL COLLECTION, NOT A SUBCOLLECTION, and the reason is cost
      // (P14): Food Cost and the recipe costing want them ALL, and one collection
      // read is far cheaper than one read per ingredient. The document id is the
      // INGREDIENT's id, so there is no second id space to keep in step.
      //
      // ⚠️ AND THE FIELDS ARE STILL WHITELISTED ON ingredients BELOW, written null
      // on every save so they drain out of documents written before this. Removing
      // a field from a whitelist while production still carries it makes those
      // documents permanently unwritable — the notifyHoursBefore / weekId trap.
      match /ingredient-prices/{id} {
        allow read: if canManage(lid, 'foodcost');

        allow create, update: if canManage(lid, 'foodcost')
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly([
               'bakery', 'priceUnit', 'pricePerUnit',
               'packPrice', 'packSize', 'unitWeightKg', 'priceUpdatedAt'
             ])
          // Every field is OPTIONAL, exactly as on the ingredient itself: this
          // document is written by the same form, which may legitimately be saved
          // with no price at all. Optional is not unchecked — each is validated
          // when present.
          && (!('priceUnit' in request.resource.data)
              || request.resource.data.priceUnit == null
              || request.resource.data.priceUnit in ['kg', 'l', 'pcs'])
          && (!('pricePerUnit' in request.resource.data)
              || request.resource.data.pricePerUnit == null
              || (request.resource.data.pricePerUnit is number
                  && request.resource.data.pricePerUnit > 0))
          && (!('unitWeightKg' in request.resource.data)
              || request.resource.data.unitWeightKg == null
              || (request.resource.data.unitWeightKg is number
                  && request.resource.data.unitWeightKg > 0))
          && (!('priceUpdatedAt' in request.resource.data)
              || request.resource.data.priceUpdatedAt == null
              || (request.resource.data.priceUpdatedAt is string
                  && request.resource.data.priceUpdatedAt.size() <= 64));

        // Deleting a price is deleting a fact about money, and the ingredient it
        // belongs to is deletable by the same people.
        allow delete: if canManage(lid, 'foodcost');
      }

      match /ingredients/{id} {
        allow read: if canReadOrdersData(lid);

        allow create, update: if canUse(lid, 'orders')
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly([
               'bakery', 'name', 'supplierId', 'brand', 'weight',
               'category', 'unit', 'active',
               'priceUnit', 'pricePerUnit', 'packPrice', 'packSize',
               'unitWeightKg', 'priceUpdatedAt',
               'allergens', 'mayContain', 'allergensCheckedAt', 'nutrition'
             ])
          && (!('name' in request.resource.data)
              || (request.resource.data.name is string
                  && request.resource.data.name.size() <= 200))
          && (!('supplierId' in request.resource.data)
              || (request.resource.data.supplierId is string
                  && request.resource.data.supplierId.size() <= 200))
          && (!('brand' in request.resource.data)
              || (request.resource.data.brand is string
                  && request.resource.data.brand.size() <= 200))
          && (!('weight' in request.resource.data)
              || (request.resource.data.weight is string
                  && request.resource.data.weight.size() <= 100))
          && (!('category' in request.resource.data)
              || (request.resource.data.category is string
                  && request.resource.data.category.size() <= 200))
          && (!('unit' in request.resource.data)
              || (request.resource.data.unit is string
                  && request.resource.data.unit.size() <= 100))
          && (!('active' in request.resource.data)
              || request.resource.data.active is bool)
          && (!('priceUnit' in request.resource.data)
              || request.resource.data.priceUnit == null
              || request.resource.data.priceUnit in ['kg', 'l', 'pcs'])
          && (!('pricePerUnit' in request.resource.data)
              || request.resource.data.pricePerUnit == null
              || (request.resource.data.pricePerUnit is number
                  && request.resource.data.pricePerUnit > 0))
          && (!('packPrice' in request.resource.data)
              || request.resource.data.packPrice == null
              || (request.resource.data.packPrice is number
                  && request.resource.data.packPrice > 0))
          && (!('packSize' in request.resource.data)
              || request.resource.data.packSize == null
              || (request.resource.data.packSize is number
                  && request.resource.data.packSize > 0))
          && (!('unitWeightKg' in request.resource.data)
              || request.resource.data.unitWeightKg == null
              || (request.resource.data.unitWeightKg is number
                  && request.resource.data.unitWeightKg > 0))
          && (!('priceUpdatedAt' in request.resource.data)
              || request.resource.data.priceUpdatedAt == null
              || (request.resource.data.priceUpdatedAt is string
                  && request.resource.data.priceUpdatedAt.size() <= 64))

          // ── Allergens and nutrition ───────────────────────────────────
          // What this ingredient declares, so a product label can be built from
          // it. ⚠️ THE CONTENTS OF THESE LISTS ARE NOT VALIDATED HERE AND CANNOT
          // BE — rules cannot look inside a list, the same limitation as `steps`
          // on a recipe. Which codes are legal is guaranteed by
          // js/allergen-model.js, which walks a closed list and drops anything
          // else. What this holds is the SIZE, which is what keeps a corrupt or
          // hostile document away from the 1MB ceiling; there are 26 codes, so
          // 40 is generous and still bounded.
          //
          // ⚠️ OPTIONAL IN BOTH DIRECTIONS ON PURPOSE, like every field added to
          // a live collection here: rules land on every phone the instant they
          // deploy while code arrives one device at a time, so a phone still on
          // the old build sends none of these and must keep saving.
          && (!('allergens' in request.resource.data)
              || (request.resource.data.allergens is list
                  && request.resource.data.allergens.size() <= 40))
          && (!('mayContain' in request.resource.data)
              || (request.resource.data.mayContain is list
                  && request.resource.data.mayContain.size() <= 40))
          // ⚠️ THE STAMP IS WHAT TELLS "checked, contains none" APART FROM "nobody
          // has said anything", and an empty string is the SECOND of those. It is
          // therefore accepted, not refused: refusing it would leave no way to
          // un-verify an ingredient whose spec turned out to be wrong.
          && (!('allergensCheckedAt' in request.resource.data)
              || request.resource.data.allergensCheckedAt == null
              || (request.resource.data.allergensCheckedAt is string
                  && request.resource.data.allergensCheckedAt.size() <= 64))
          // A map of seven numbers per 100 g, each of which may be null — null
          // means "not filled in" and 0 means zero, and the two are different
          // (water really is 0 kcal). The values themselves are bounded by the
          // model; only the shape and the key count are checked here.
          && (!('nutrition' in request.resource.data)
              || (request.resource.data.nutrition is map
                  && request.resource.data.nutrition.keys().hasOnly(
                       ['kj', 'kcal', 'fat', 'saturates', 'carbs', 'sugars', 'protein', 'salt'])));

        // OWNER ONLY, and this is the one that costs the most to undo: recipe
        // rows link to it, Food Cost prices through it, and its allergen
        // declaration is what lets a label be printed at all. Deleting it also
        // resets its suggestion history for ever, because past orders are keyed
        // by id and a re-created ingredient starts from scratch.
        allow delete: if canManage(lid, 'orders');

        // ── What this ingredient has cost over time ───────────────────────
        // APPEND-ONLY BY CONSTRUCTION: create is allowed, update and delete are
        // not. That is the whole point — this is the record the margin history
        // will later be reconstructed from, and a record that can be edited
        // afterwards answers nothing. Correcting a price means adding the
        // corrected one, which is also what actually happened.
        //
        // ⚠️ A SUBCOLLECTION IS NOT COVERED BY ITS PARENT'S RULES. Without this
        // block the documents fall through to the default-deny at the bottom of
        // the file and every write is refused — silently, from the app's point of
        // view, because a rejected write looks like a network problem.
        //
        // Written WHOLE, and the collection is brand new, so every field can be
        // REQUIRED rather than optional: there is no phone anywhere running an
        // older writer whose payload would suddenly start being refused. Same
        // reasoning, and the same limit, as the pastries block further down —
        // and, as there, never copy this shape onto a collection production
        // already carries.
        //
        // The document id is generated by Firestore, NOT taken from the
        // timestamp. An id that is the moment of the write makes two prices saved
        // in the same millisecond collide, and with update denied the second one
        // would simply be refused. Ordering is done by the `recordedAt` FIELD,
        // which is also the only thing Firestore can order descending.
        // ⚠️ canManage(…, 'foodcost'), NOT canReadOrdersData. This is the price
        // HISTORY: it answers "what did we pay, and when did it go up", which is
        // the same money the Food Cost screen is now closed over. Leaving it on
        // the Orders gate would be the back door into the thing the front door
        // was just locked.
        match /prices/{priceId} {
          allow read: if canManage(lid, 'foodcost');

          allow create: if canManage(lid, 'foodcost')
            && stampedFor(lid)
            && request.resource.data.keys().hasOnly([
                 'bakery', 'recordedAt', 'priceUnit', 'pricePerUnit',
                 'packPrice', 'packSize', 'unitWeightKg', 'supplierId', 'source'
               ])
            && request.resource.data.recordedAt is string
            && request.resource.data.recordedAt.size() > 0
            && request.resource.data.recordedAt.size() <= 64
            && request.resource.data.priceUnit in ['kg', 'l', 'pcs']
            && request.resource.data.pricePerUnit is number
            && request.resource.data.pricePerUnit > 0
            // ⚠️ packPrice/packSize ARE RETIRED AND MUST STAY OPTIONAL IN BOTH
            // DIRECTIONS. The rate used to be derived from them and is now typed,
            // so a phone on the new code sends neither — but rules reach every
            // phone the instant they are deployed while code arrives per device,
            // and a phone still on the old code sends both. Require them and
            // every price saved from an un-updated phone is refused; forbid them
            // and the same happens in reverse. Old records keep them, and they
            // are what makes "£180 for 25kg" still readable years later.
            && (!('packPrice' in request.resource.data)
                || request.resource.data.packPrice == null
                || (request.resource.data.packPrice is number
                    && request.resource.data.packPrice > 0))
            && (!('packSize' in request.resource.data)
                || request.resource.data.packSize == null
                || (request.resource.data.packSize is number
                    && request.resource.data.packSize > 0))
            // Only a per-piece price has one.
            && (!('unitWeightKg' in request.resource.data)
                || request.resource.data.unitWeightKg == null
                || (request.resource.data.unitWeightKg is number
                    && request.resource.data.unitWeightKg > 0))
            && request.resource.data.supplierId is string
            && request.resource.data.supplierId.size() <= 200
            && request.resource.data.source in ['manual', 'invoice'];

          allow update, delete: if false;
        }
      }

      // ── The order in progress ───────────────────────────────────────────
      // One document, drafts/current, merge-written on every keystroke and
      // cleared per supplier with deleteField. `weekId` is retired but still on
      // the live document, so it stays listed. Delete stays denied: nothing in
      // the app deletes the draft, and clearFields would fail on a missing doc.
      match /drafts/{id} {
        allow read: if canUse(lid, 'orders');

        allow create, update: if canUse(lid, 'orders')
          && id == 'current'
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly([
               'bakery', 'entries', 'days', 'updatedAt', 'weekId'
             ])
          && (!('entries' in request.resource.data)
              || (request.resource.data.entries is map
                  && request.resource.data.entries.size() <= 2000))
          && (!('days' in request.resource.data)
              || (request.resource.data.days is map
                  && request.resource.data.days.size() <= 200))
          && (!('updatedAt' in request.resource.data)
              || (request.resource.data.updatedAt is string
                  && request.resource.data.updatedAt.size() <= 64))
          && (!('weekId' in request.resource.data)
              || (request.resource.data.weekId is string
                  && request.resource.data.weekId.size() <= 32));

        allow delete: if false;
      }

      // ── Order history ───────────────────────────────────────────────────
      // Two allow statements, ORed by Firestore; the document id decides which
      // applies. Current model: one doc per day per supplier, always written
      // WHOLE, so fields can be required. Legacy: the retired weekly archive,
      // exactly one such document, still read and still editable.
      match /orders-history/{id} {
        allow read: if canUse(lid, 'orders');

        allow create, update: if canUse(lid, 'orders')
          && stampedFor(lid)
          && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_.+$')
          && request.resource.data.keys().hasOnly([
               'bakery', 'date', 'supplierId', 'supplierName',
               'quantities', 'stock', 'names', 'createdAt', 'updatedAt',
               // The delivery half of an order's life — see the note below.
               'deliveredAt', 'missing'
             ])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.supplierId is string
          && request.resource.data.supplierId.size() > 0
          && request.resource.data.supplierId.size() <= 200
          && request.resource.data.supplierName is string
          && request.resource.data.supplierName.size() <= 200
          && request.resource.data.quantities is map
          && request.resource.data.quantities.size() <= 500
          && request.resource.data.stock is map
          && request.resource.data.stock.size() <= 500
          // The ingredient names as they read the day the order was placed, so a past
          // order still names what was bought after that ingredient is deleted (before
          // this, the screen fell back to the raw document id).
          //
          // OPTIONAL on purpose: rules apply to every phone the instant they deploy,
          // while code rolls out per device. Required, it would refuse every order from
          // a phone still on the previous version.
          && (!('names' in request.resource.data)
              || (request.resource.data.names is map
                  && request.resource.data.names.size() <= 500))
          // ── The delivery half of an order's life (14 Aug 2026) ──────────
          //
          // `deliveredAt` — when somebody said this order turned up. Empty or
          // absent means still waiting, and that is what makes the screen work:
          // the app is TOLD what arrived, it never deduces it from the
          // supplier's delivery days. Deducing would drop an order off the list
          // the day it was due, so the one that never came would be the only one
          // nobody ever sees.
          //
          // `missing` — { ingredientId: true } for what was ordered and did not
          // arrive. ⚠️ IT SITS BESIDE `quantities`, IT DOES NOT EDIT IT.
          // `quantities` is the map the suggestion engine averages over, so
          // removing a row would quietly change what the app suggests for months
          // — and destroy the evidence the thing was ordered at all, which is
          // what you need to chase a supplier. Federico's decision, 14 Aug 2026.
          //
          // BOTH OPTIONAL, in both directions, for the same reason as `names`
          // above: rules reach every phone the instant they deploy while code
          // arrives one device at a time. Required, they would refuse every
          // order from a phone still on the previous version; forbidden, they
          // would refuse every order from a phone already on the new one.
          && (!('deliveredAt' in request.resource.data)
              || (request.resource.data.deliveredAt is string
                  && request.resource.data.deliveredAt.size() <= 64))
          && (!('missing' in request.resource.data)
              || (request.resource.data.missing is map
                  && request.resource.data.missing.size() <= 500))
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 64
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64;

        // The legacy branch is now pinned to the weekly id shape it was written
        // for (`2026-W28`). It used to accept ANY id that merely failed to look
        // like a daily one, which made `orders-history/anything-at-all` a legal
        // place to put a document. Exactly one such record exists, from July 2026,
        // and nothing has written this shape since v179.
        allow create, update: if canUse(lid, 'orders')
          && stampedFor(lid)
          && id.matches('^[0-9]{4}-W[0-9]{2}$')
          && request.resource.data.keys().hasOnly([
               'bakery', 'weekStart', 'date', 'quantities',
               'stock', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.weekStart is string
          && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (!('date' in request.resource.data)
              || (request.resource.data.date is string
                  && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && request.resource.data.quantities is map
          && request.resource.data.quantities.size() <= 500
          && request.resource.data.stock is map
          && request.resource.data.stock.size() <= 500
          && (!('createdAt' in request.resource.data)
              || (request.resource.data.createdAt is string
                  && request.resource.data.createdAt.size() <= 64))
          && (!('updatedAt' in request.resource.data)
              || (request.resource.data.updatedAt is string
                  && request.resource.data.updatedAt.size() <= 64));

        allow delete: if canUse(lid, 'orders');
      }

      // ── An order list one person sends to another ───────────────────────
      // Somebody prepares the order and sends it INSIDE the app; a manager opens
      // it and ticks each ingredient off as it is bought. A frozen photograph of
      // what was sent — the shared draft moves on, and the manager must be able
      // to see what they were actually handed.
      //
      // ⚠️ FLAT MAPS, NOT A NESTED LIST, AND THAT IS WHY EVERY PART CAN BE
      // CHECKED HERE. These rules cannot look inside a list (the same limit that
      // left the WhatsApp free lines unvalidated), so a nested shape could only
      // be checked for being a list at all. As maps, every piece gets a type and
      // a ceiling. It is also the shape orders-history has carried for a year.
      //
      // ⚠️ `quantities` MUST NOT BE EMPTY. There is no such thing as an empty
      // order list: it is a list of work, and one with no work in it can only
      // mislead the person it was sent to. The app refuses to build one; this is
      // the half that cannot be bypassed by a stale phone.
      match /order-requests/{id} {
        allow read: if canUse(lid, 'orders');

        allow create: if canUse(lid, 'orders')
          && stampedFor(lid)
          // ⚠️ NOBODY MAY SEND A LIST IN SOMEBODY ELSE'S NAME. The receiving
          // screen prints this, and a manager acts on who they think asked.
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
               'bakery', 'date', 'fromUid', 'fromName', 'quantities', 'names',
               'supplierOf', 'supplierNames', 'done', 'note',
               'createdAt', 'updatedAt'
             ])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 200
          && request.resource.data.quantities is map
          && request.resource.data.quantities.size() > 0
          && request.resource.data.quantities.size() <= 500
          && request.resource.data.names is map
          && request.resource.data.names.size() <= 500
          && request.resource.data.supplierOf is map
          && request.resource.data.supplierOf.size() <= 500
          && request.resource.data.supplierNames is map
          && request.resource.data.supplierNames.size() <= 200
          // ⚠️ IT IS BORN WITH NO TICKS. A list that arrived already ticked would
          // be a list the manager never sees in the banner — sent and silently
          // finished, which is the one outcome this whole feature exists to stop.
          && request.resource.data.done is map
          && request.resource.data.done.size() == 0
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 64
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64;

        // ⚠️⚠️ DELIBERATELY THE NARROWEST UPDATE IN THIS FILE: the ticks, and the
        // stamp that says when. Everything else is pinned to what is already
        // stored, so ticking an ingredient off can never become the door through
        // which somebody's quantities are quietly rewritten after they were sent.
        // Same technique, and the same reason, as `active` on push-timers.
        allow update: if canUse(lid, 'orders')
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['done', 'updatedAt'])
          && request.resource.data.done is map
          && request.resource.data.done.size() <= 500
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64;

        // ⚠️ THE ONE THING HERE BEHIND THE ROLE, AND IT IS A DELIBERATE DEPARTURE
        // from orders-history and pastry-logs, which any member may delete. The
        // rule stated above for those is "it is how a person corrects their OWN
        // work" — and it holds, because they are RECORDS of something already
        // done. This is not a record: it is work NOT yet done, addressed to
        // somebody else. Deleting it means the ingredients are never bought and
        // nobody finds out, which no backup helps with because nothing was lost —
        // it was never ordered. Sending a corrected list costs one minute.
        allow delete: if canManage(lid, 'orders');
      }

      // ── Configuration: config/calculator and config/orders ──────────────
      // config/orders belongs to the Orders screen, config/calculator to the
      // Calculator, so each is gated by its own section.
      //
      // ⚠️ THIS DOCUMENT IS THE ADDRESS BOOK — clients, their products, the
      // recipes — and it cannot be deleted or rolled back from the app. It was
      // the ONE collection with no field validation at all: any authenticated
      // device could put anything of any shape in it, up to Firestore's 1MB.
      // A client bug was enough; nothing had to be malicious.
      //
      // ⚠️ THE LIST IS DELIBERATELY WIDER THAN WHAT TODAY'S CODE WRITES. Rules
      // reach every phone the instant they deploy, while code arrives per device,
      // so anything a not-yet-updated phone still sends must remain legal or its
      // saves start failing: `products` (the shared catalogue, v1.5.0–v1.21.x),
      // `groups`, and the original per-tab keys. Same reasoning as
      // notifyHoursBefore on suppliers. Remove one only after production has
      // stopped carrying it.
      //
      // Sizes are generous — they exist to stop a runaway document, not to
      // second-guess a bakery that grows.
      match /config/{doc} {
        allow read: if member(lid)
          && sectionOn(lid, doc == 'orders' ? 'orders' : 'calculator');

        // ⚠️⚠️ WHO MAY WRITE DEPENDS ON WHICH DOCUMENT IT IS, AND THAT TERNARY IS
        // LOAD-BEARING. `config/orders` decides how the venue works — which roads
        // an order may leave by, whether stock is shown — so it belongs to the
        // owner and the manager. `config/calculator` is the address book, the
        // recipes and the products, which the people doing the work edit all day.
        // Tightening the WHOLE block would stop an employee saving the Calculator,
        // and the failure would arrive as a permission error with nothing on screen
        // explaining it. The ternary already used for `sectionOn` one line down is
        // the same distinction; this simply applies it to the writer as well.
        //
        // ⚠️ READING STAYS OPEN TO EVERY MEMBER. An employee has to know which
        // roads they have, or the send screen could not draw itself.
        // ⚠️⚠️ THE SECTION CHECK IS INSIDE EACH BRANCH, NOT SHARED, AND THAT IS
        // NOT TIDINESS — IT IS THE READ BUDGET. canManage() already contains
        // canUse(), which is member() + sectionOn(); leaving the outer sectionOn()
        // in place made this rule ask for the same documents twice and pushed it
        // past Firestore's ceiling of ten document reads per evaluation. It did
        // not fail cleanly either: the checks came back with an EVALUATION ERROR,
        // which is a refusal nobody can explain rather than a decision. This
        // ruleset has been at that ceiling before, and one extra get() has
        // produced exactly this before.
        allow create, update: if (doc == 'orders'
              ? canManage(lid, 'orders')
              : (member(lid) && sectionOn(lid, 'calculator')))
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly([
               'bakery', 'configRev',
               // Calculator
               'clients', 'recipes', 'ingredients',
               'whatsappLists', 'whatsappClients',
               'extraDough', 'divisorIncluded',
               'logVisibility', 'logRetentionHours', 'logRetentionByDough',
               'orderPrefillWindow',
               // Orders
               'showStock', 'historyDays',
               // Which roads an order may leave by, and which is offered first.
               'sendRoutes', 'preferredRoute',
               // Which day the working week starts on.
               'weekStartsOn',
               // Retired, still writable by an un-updated phone (see above)
               'products', 'groups', 'focaccia', 'brioche', 'sourdough', 'market'
             ])
          && (!('configRev' in request.resource.data)
              || request.resource.data.configRev is number)
          && (!('clients' in request.resource.data)
              || (request.resource.data.clients is list
                  && request.resource.data.clients.size() <= 200))
          && (!('recipes' in request.resource.data)
              || (request.resource.data.recipes is list
                  && request.resource.data.recipes.size() <= 200))
          && (!('ingredients' in request.resource.data)
              || (request.resource.data.ingredients is list
                  && request.resource.data.ingredients.size() <= 1000))
          && (!('products' in request.resource.data)
              || (request.resource.data.products is list
                  && request.resource.data.products.size() <= 500))
          && (!('whatsappLists' in request.resource.data)
              || (request.resource.data.whatsappLists is list
                  && request.resource.data.whatsappLists.size() <= 100))
          && (!('whatsappClients' in request.resource.data)
              || (request.resource.data.whatsappClients is list
                  && request.resource.data.whatsappClients.size() <= 100))
          && (!('showStock' in request.resource.data)
              || request.resource.data.showStock is bool)
          && (!('historyDays' in request.resource.data)
              || request.resource.data.historyDays is number)
          // Which roads an order may leave by. A map of four booleans, and a
          // preferred one.
          //
          // ⚠️ OPTIONAL IN BOTH DIRECTIONS, as every field here has to be: rules
          // reach every phone the instant they deploy while code arrives one device
          // at a time. Required, a phone still on the previous version could not
          // save Settings at all.
          //
          // ⚠️ THE SIZE CAP IS 8, NOT 4. The four names are checked by the app, and
          // the rules deliberately do not hard-code them — a fifth road would then
          // need a rules deploy before the code that offers it, which is the wrong
          // way round for something that cannot do any harm. The cap is there so the
          // map cannot be used as free storage.
          && (!('sendRoutes' in request.resource.data)
              || (request.resource.data.sendRoutes is map
                  && request.resource.data.sendRoutes.size() <= 8))
          && (!('preferredRoute' in request.resource.data)
              || (request.resource.data.preferredRoute is string
                  && request.resource.data.preferredRoute.size() <= 32))
          // Which day the working week starts on — it decides what "this week" means
          // on the Incoming screen.
          //
          // ⚠️ A STRING, CHECKED AS ONE. The app already refuses anything that is not
          // a plain string (a LIST holding 'Monday' stringifies to 'Monday', which is
          // how a list nearly became a decision), and the rules refuse it too: two
          // guards for one fact, because the app can be old on a phone while the rules
          // are always current.
          //
          // ⚠️ OPTIONAL IN BOTH DIRECTIONS, like every field here.
          && (!('weekStartsOn' in request.resource.data)
              || (request.resource.data.weekStartsOn is string
                  && request.resource.data.weekStartsOn.size() <= 16))
          // Which days the WhatsApp order form fills itself from. A closed set: this
          // value decides which quantities are offered for a message sent to a real
          // client, so an unrecognised one must not reach the database in the first
          // place. OPTIONAL, because a phone still on older code writes this document
          // without the field at all.
          && (!('orderPrefillWindow' in request.resource.data)
              || request.resource.data.orderPrefillWindow in ['both', 'yesterday', 'today']);

        allow delete: if false;
      }

      // ── A client's ordering account ─────────────────────────────────────
      // One document per ordering account, named by its Firebase uid, saying which
      // client of THIS location it may act as. Created when the owner makes an
      // ordering link from the Clients screen; deleting it revokes that link
      // instantly and leaves the account able to do nothing anywhere.
      //
      // The account reads its OWN document to learn which client it is — it cannot
      // list the collection or read anybody else's, so one client can never discover
      // that another exists, let alone who.
      match /client-accounts/{uid} {
        allow read: if member(lid) || (signedIn() && request.auth.uid == uid);

        // OWNER ONLY, and the only WRITE gated in this change rather than a
        // delete. This document is what hands an account outside the business a
        // way in — it is the nearest thing this app has to granting access, and
        // granting access is the owner's job by definition. Revoking it (below)
        // is owner-only for the same reason: a revoke cuts off a customer's
        // phone mid-order.
        allow create, update: if canManage(lid, 'calculator')
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly(
               ['bakery', 'clientId', 'clientName', 'createdAt', 'linkToken'])
          && request.resource.data.clientId is string
          && request.resource.data.clientId.size() > 0
          && request.resource.data.clientId.size() <= 64
          // ⚠️ NO UNDERSCORE, and this is not tidiness. An order document is named
          // `{date}_{clientId}` and the rule below recovers the client by splitting
          // on that underscore. One inside the id would split into three pieces and
          // compare the wrong half — a rule that fails open or closed depending on
          // the customer's name. Refused here, at the only place an id is minted.
          && !request.resource.data.clientId.matches('.*_.*')
          && request.resource.data.clientName is string
          && request.resource.data.clientName.size() <= 200
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 64
          // ⚠️ THIS IS A CAPABILITY TOKEN, AND STORING IT IS A DELIBERATE TRADE-OFF.
          // It is the secret inside the ordering link, kept so the owner can re-send
          // that link to a client who changed phone WITHOUT breaking the session on
          // the phone that still works — the alternative, minting a new account each
          // time, revokes the client currently using it every time you help them.
          //
          // What makes it acceptable is what it is worth: a machine-generated secret
          // for a single-purpose account that can read one product list and write one
          // client's order, nothing else, revoked by deleting this document. It is
          // not a person's password, it is not reused anywhere, and it is readable
          // only by the location's own staff — who can already read every order and
          // every price — and by the account it belongs to, which already has it.
          //
          // ⚠️ Do NOT copy this pattern for anything a human chooses or reuses.
          && (!('linkToken' in request.resource.data)
              || (request.resource.data.linkToken is string
                  && request.resource.data.linkToken.size() <= 128));

        // OWNER ONLY — see the create above. Deleting this IS the revoke.
        allow delete: if canManage(lid, 'calculator');
      }

      // ── The one setting a client's own page has to know ─────────────────
      // When orders for a day close. The client page applies it and, more to the
      // point, SHOWS it — a day quietly missing from the picker looks like a bug,
      // while a sentence saying when orders close is a rule somebody can work with.
      //
      // ⚠️ IT IS A COLLECTION OF ITS OWN AND NOT A FIELD ON config/calculator, and
      // that is the whole reason it exists. The client page must be able to read it,
      // and config/calculator is the entire address book — every client, every
      // product of every client, every recipe — in a single document. There is no way
      // to share one field of it without sharing all of it, so the field moves out to
      // where it can be shared safely.
      //
      // Deliberately readable by EVERY ordering account of this location, not only by
      // the client it concerns: it is one clock time, the same for all of them, and
      // it is already printed on each of their screens.
      match /client-settings/{doc} {
        allow read: if member(lid) || orderClientOf(lid) != '';

        allow create, update: if canUse(lid, 'calculator')
          && stampedFor(lid)
          && doc == 'orders'
          && request.resource.data.keys().hasOnly(['bakery', 'cutoff', 'updatedAt'])
          // ⚠️ AN EMPTY STRING IS A REAL ANSWER: no deadline at all, which is how a
          // bakery that takes same-day orders switches it off. Refusing it here would
          // make "no deadline" unexpressible and leave a cleared box silently keeping
          // the old time.
          && request.resource.data.cutoff is string
          && (request.resource.data.cutoff == ''
              || request.resource.data.cutoff.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64;

        allow delete: if false;
      }

      // ── What a client is allowed to see of the address book ─────────────
      // The thin slice: this client's own products, and nothing else.
      //
      // ⚠️ IT EXISTS SO A CLIENT NEVER READS config/calculator. That one document
      // holds every client, every product of every client, every recipe and every
      // setting — the whole business in a single read. Publishing a copy of the four
      // fields a client actually needs is the only way to show someone their own
      // order form without showing them everyone else's.
      match /client-menus/{clientId} {
        allow read: if member(lid) || isOrderClient(lid, clientId);

        allow create, update: if canUse(lid, 'calculator')
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly(
               ['bakery', 'bakeryName', 'clientName', 'country', 'products', 'updatedAt'])
          && request.resource.data.clientName is string
          && request.resource.data.clientName.size() <= 200
          // ⚠️ THE COUNTRY DECIDES WHAT LANGUAGE THE CLIENT'S OWN PAGE IS IN, for
          // the same reason it decides a label's: that page is read by the
          // bakery's customer, in the country the bakery sells in. It travels
          // here because the client cannot read locations/{lid} — staff-only on
          // purpose, since it also lists which sections the venue uses.
          //
          // ⚠️ OPTIONAL IN BOTH DIRECTIONS, ON PURPOSE. Every menu published
          // before today has no country, and rules reach every phone instantly
          // while code arrives per device — a required field would refuse every
          // save from a phone still on the old code. Optional is not unchecked:
          // when it is there it must be one of the two the app knows.
          && (!('country' in request.resource.data)
              || request.resource.data.country in ['GB', 'IT'])
          // ⚠️ bakeryName IS HOW THE CLIENT PAGE LEARNS WHO IT IS FROM. That page
          // cannot read locations/{lid} — the location document is staff-only on
          // purpose, because it also lists which sections the venue uses — so the
          // name has to travel to the client on something the client may read.
          // This document is republished every time the address book is saved, so
          // a venue that renames itself corrects every client's page by itself.
          //
          // ⚠️ OPTIONAL IN BOTH DIRECTIONS, deliberately: every menu written before
          // today lacks it, and rules reach every phone the instant they deploy
          // while code arrives per device. Required, and every save from a phone
          // still on the old code would be refused.
          && (!('bakeryName' in request.resource.data)
              || (request.resource.data.bakeryName is string
                  && request.resource.data.bakeryName.size() <= 200))
          // ⚠️ RULES CANNOT LOOK INSIDE A LIST, so the shape of each row
          // ({ id, name, kind }) is guaranteed by js/client-order-model.js and NOT by
          // this file. What is enforced here is the SIZE, which is what keeps the
          // document away from the 1MB ceiling. Same division of labour as recipes.
          && request.resource.data.products is list
          && request.resource.data.products.size() <= 500
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64;

        // OWNER ONLY, to travel with the account above — a menu without its
        // account is a client that can sign in and see nothing. Nothing in the
        // app deletes this today (checked), so gating it costs no daily work;
        // the create/update stays open because saving the address book
        // republishes every changed menu, and that is ordinary work.
        allow delete: if canManage(lid, 'calculator');
      }

      // ── An order a client typed themselves ──────────────────────────────
      // One document per delivery DATE per client: 2026-08-11_c-clubfish. Correcting
      // an order rewrites that document rather than adding a second, so what the
      // bakery reads is always the client's current answer and never a pile of
      // amendments to reconcile by hand.
      //
      // TWO allow branches, ORed by Firestore — the same shape orders-history uses.
      // The bakery's branch may write everything; the client's branch is narrower in
      // three specific ways, each of which is a real failure it prevents.
      match /client-orders/{id} {

        // The client half of `{date}_{clientId}`, or '' when the id is not that
        // shape. Guarded rather than indexed blindly: an id with no underscore makes
        // split()[1] an out-of-range access, and a rule that ERRORS is a rule whose
        // outcome nobody reading this file can predict.
        function orderIdClient(orderId) {
          return orderId.split('_').size() == 2 ? orderId.split('_')[1] : '';
        }

        function orderDateOf(date) {
          return timestamp.date(
            int(date.split('-')[0]), int(date.split('-')[1]), int(date.split('-')[2]));
        }

        // ⚠️ A COARSE FLOOR, NOT THE BUSINESS DEADLINE, AND THE DIFFERENCE IS THE
        // POINT. The real cutoff ("orders for a day close at 16:00 the day before")
        // is applied by the client page and, more importantly, is SHOWN to the bakery
        // — a late correction arrives with a mark on it rather than being silently
        // accepted or silently refused.
        //
        // It is not written here because these rules have no idea what the local time
        // is: the UK moves an hour twice a year, so an exact deadline expressed in
        // UTC would be wrong for half of it. Being wrong by an hour, quietly, for six
        // months is worse than being generous on purpose.
        //
        // What this DOES guarantee, and no page can talk it out of: nobody rewrites
        // an order for a day that is well past (the archive of what was really asked
        // for stays put), and nobody books a year of deliveries in an afternoon.
        function orderDateSane(date) {
          return request.time < orderDateOf(date) + duration.value(36, 'h')
            && request.time > orderDateOf(date) - duration.value(60, 'd');
        }

        // `names` and `note` are OPTIONAL in both directions on purpose. The client
        // page is the newest thing in this app and will change; rules reach every
        // phone the instant they deploy while a page is re-fetched per device, so a
        // field required here and absent there refuses every order until the cache
        // turns over. Same reasoning as orders-history.names and pastries.note.
        //
        // ⚠️ RULES CANNOT LOOK INSIDE A MAP'S VALUES, so "a quantity is a positive
        // number" is guaranteed by js/client-order-model.js and not by this file.
        // What is enforced here is that `quantities` IS a map and how big it may get.
        function validClientOrder(orderId) {
          return request.resource.data.keys().hasOnly([
                   'bakery', 'date', 'clientId', 'clientName', 'quantities',
                   'names', 'note', 'createdAt', 'updatedAt', 'appliedAt', 'appliedFor'
                 ])
            && request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.clientId is string
            && request.resource.data.clientId.size() > 0
            && request.resource.data.clientId.size() <= 64
            && !request.resource.data.clientId.matches('.*_.*')
            // The folder and the fields can never disagree about whose order this is,
            // or for which day — the same pinning as pastry-logs.
            && orderId == request.resource.data.date + '_' + request.resource.data.clientId
            && request.resource.data.clientName is string
            && request.resource.data.clientName.size() <= 200
            && request.resource.data.quantities is map
            && request.resource.data.quantities.size() <= 200
            && (!('names' in request.resource.data)
                || (request.resource.data.names is map
                    && request.resource.data.names.size() <= 200))
            && (!('note' in request.resource.data)
                || (request.resource.data.note is string
                    && request.resource.data.note.size() <= 500))
            && request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() <= 64
            && request.resource.data.updatedAt is string
            && request.resource.data.updatedAt.size() <= 64;
        }

        // ── The bakery ──
        allow read: if canUse(lid, 'calculator');

        allow create, update: if canUse(lid, 'calculator')
          && stampedFor(lid)
          && validClientOrder(id)
          && (!('appliedAt' in request.resource.data)
              || (request.resource.data.appliedAt is string
                  && request.resource.data.appliedAt.size() <= 64))
          && (!('appliedFor' in request.resource.data)
              || (request.resource.data.appliedFor is string
                  && request.resource.data.appliedFor.size() <= 64));

        allow delete: if canUse(lid, 'calculator');

        // ── The client ──
        // Reads its own order back so the form opens on what it last sent. The client
        // is recovered from the document ID, not from the payload, because a read has
        // no payload — and because the id is the one thing the client cannot lie
        // about: it is the path the request is addressed to.
        allow read: if isOrderClient(lid, orderIdClient(id));

        allow create: if isOrderClient(lid, request.resource.data.get('clientId', ''))
          && stampedFor(lid)
          && validClientOrder(id)
          && orderDateSane(request.resource.data.date)
          // Nothing about "the bakery has used this" may be invented by the client.
          && !('appliedAt' in request.resource.data)
          && !('appliedFor' in request.resource.data);

        allow update: if isOrderClient(lid, request.resource.data.get('clientId', ''))
          && stampedFor(lid)
          && validClientOrder(id)
          && orderDateSane(request.resource.data.date)
          // ⚠️ THE CLIENT MUST CARRY THESE TWO FORWARD UNCHANGED, and this is the
          // subtlest rule in the block. A correction is written WHOLE (a merge could
          // never remove a row the client deleted), so a payload that simply omits
          // them would ERASE the record that the bakery had already put this order
          // into the Calculator — and the screen would stop warning that the order
          // changed after it was used. That warning is the one thing standing between
          // a late correction and the wrong amount of bread.
          && request.resource.data.get('appliedAt', '') == resource.data.get('appliedAt', '')
          && request.resource.data.get('appliedFor', '') == resource.data.get('appliedFor', '');

        // No client delete, deliberately: an order that vanishes is indistinguishable
        // from one that was never sent, and the bakery may already have baked it.
        // Ordering nothing is an order with no lines, which is a different statement
        // and reads as one on the screen.
      }

      // ── Recipe catalogue ────────────────────────────────────────────────
      // ⚠️ RULES CANNOT LOOK INSIDE A LIST, so the shape of each ingredient row —
      // and in particular the `kind`/`refId` link that decides what a row COSTS —
      // is guaranteed by js/catalogue/catalogue-model.js and NOT by this file.
      // What is enforced here is the list's SIZE, which keeps the document away
      // from the 1MB ceiling. Same limitation, same division of labour, as the
      // pastries block below.
      //
      // `lossPct` is the weight a recipe loses on the way to being finished, and
      // `steps` is its guided mixing procedure. Both are OPTIONAL, in both
      // directions on purpose: rules reach every phone the instant they deploy
      // while code arrives per device, so required would refuse every save from a
      // phone still on the previous version, and absent from the whitelist would
      // refuse every save from an updated one. Same precedent as
      // orders-history.names and pastries.note.
      match /recipes/{id} {
        // Read by the catalogue that owns them AND by Food Cost, which costs a
        // product from them. Writing stays the catalogue's alone.
        allow read: if member(lid)
          && (sectionOn(lid, 'catalogue') || sectionOn(lid, 'foodcost'));
        allow create, update: if canUse(lid, 'catalogue')
          && request.resource.data.keys().hasOnly(['bakery', 'name', 'ingredients', 'lossPct', 'steps', 'endNote'])
          && stampedFor(lid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 200
          && request.resource.data.ingredients is list
          && request.resource.data.ingredients.size() <= 300
          // Capped at 99 here as well as in the model: the yield weight is the
          // divisor of the price per kilo, and a stored 100 would make every
          // recipe built on this one cost Infinity per kilo.
          && (!('lossPct' in request.resource.data)
              || (request.resource.data.lossPct is number
                  && request.resource.data.lossPct >= 0
                  && request.resource.data.lossPct <= 99))
          // The guided mixing procedure: an ordered list of steps, each naming the
          // rows to add, how long to run, and at what speed. ⚠️ A STEP'S CONTENTS
          // ARE NOT VALIDATED HERE AND CANNOT BE — same list limitation as the
          // ingredient rows above, so the shape is guaranteed by
          // js/catalogue/guided-model.js. What this holds is the SIZE, which is
          // what keeps the document away from the 1MB ceiling; a real procedure is
          // ten steps, so 100 is generous and still bounded.
          && (!('steps' in request.resource.data)
              || (request.resource.data.steps is list
                  && request.resource.data.steps.size() <= 100))
          // The closing message shown when a guided mix finishes. OPTIONAL IN BOTH
          // DIRECTIONS ON PURPOSE: rules reach every phone the instant they are
          // deployed while code rolls out one device at a time, so a phone still on
          // the old build sends no `endNote` and must keep saving, and a phone on
          // the new build sends one — even an empty one — and must not be refused.
          // Optional is not unchecked: when present it is still a bounded string.
          && (!('endNote' in request.resource.data)
              || (request.resource.data.endNote is string
                  && request.resource.data.endNote.size() <= 300));
        // OWNER ONLY. A recipe is the business. It also carries the guided
        // procedure, the allergen links and whatever Food Cost products point
        // at it, none of which say so from the delete button.
        allow delete: if canManage(lid, 'catalogue');
      }

      // ── Finished products, and what they earn ───────────────────────
      // A product is a batch — kilos of recipes plus packaging counted in pieces —
      // with the price it sells for and the food-cost target it is measured
      // against. Written WHOLE by the editor, so the keys are listed exactly; but
      // only `name` is REQUIRED, because a product is created before anybody knows
      // its price and must be saveable half-filled. The screen says what is still
      // missing; refusing the save instead would mean losing the work.
      //
      // ⚠️ vatRate ACCEPTS 0. Most takeaway bakery in the UK is zero-rated, so a
      // rule demanding a positive rate would refuse the bakery's main line. It is
      // the one number here that may legitimately be zero.
      //
      // ⚠️ THE COMPONENT ROWS ARE NOT VALIDATED AND CANNOT BE — rules cannot look
      // inside a list. Their shape is guaranteed by js/foodcost/foodcost-model.js.
      // What is enforced here is the LIST SIZE, which keeps the document far from
      // the 1MB ceiling. Same division of labour as recipes and pastries.
      // ⚠️⚠️ canManage AND NOT canUse — READ INCLUDED, WHICH IS THE UNUSUAL PART.
      // Everywhere else in this ruleset the role gates only what cannot be undone,
      // and reading is open to anybody in the location. Here the READING is the
      // thing being protected: this collection is what each product SELLS for and
      // what it costs to make, and the whole reason Federico asked for a third role
      // is that an employee should not see the money.
      //
      // ⚠️ AND IT IS HALF THE ANSWER UNTIL THE PURCHASE PRICE MOVES. `pricePerUnit`
      // still sits on ingredients/{id}, which Orders must read to work at all — so
      // an employee cannot see the MARGIN but can still see what a sack of flour
      // costs. The other half is its own PR, and it must land before any real price
      // is typed or it stops being a rename and becomes a data migration.
      match /products/{id} {
        allow read: if canManage(lid, 'foodcost');

        allow create, update: if canManage(lid, 'foodcost')
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly([
               'bakery', 'name', 'components', 'packaging', 'sellingMode',
               'piecesPerBatch', 'sellingPrice', 'vatRate', 'foodCostTarget'
             ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && (!('components' in request.resource.data)
              || (request.resource.data.components is list
                  && request.resource.data.components.size() <= 100))
          && (!('packaging' in request.resource.data)
              || (request.resource.data.packaging is list
                  && request.resource.data.packaging.size() <= 100))
          && (!('sellingMode' in request.resource.data)
              || request.resource.data.sellingMode == null
              || request.resource.data.sellingMode in ['piece', 'weight'])
          && (!('piecesPerBatch' in request.resource.data)
              || request.resource.data.piecesPerBatch == null
              || (request.resource.data.piecesPerBatch is number
                  && request.resource.data.piecesPerBatch > 0))
          && (!('sellingPrice' in request.resource.data)
              || request.resource.data.sellingPrice == null
              || (request.resource.data.sellingPrice is number
                  && request.resource.data.sellingPrice > 0))
          && (!('vatRate' in request.resource.data)
              || request.resource.data.vatRate == null
              || (request.resource.data.vatRate is number
                  && request.resource.data.vatRate >= 0
                  && request.resource.data.vatRate <= 100))
          && (!('foodCostTarget' in request.resource.data)
              || request.resource.data.foodCostTarget == null
              || (request.resource.data.foodCostTarget is number
                  && request.resource.data.foodCostTarget > 0
                  && request.resource.data.foodCostTarget <= 100));

        // OWNER ONLY. Deleting a product takes its margin history (the nested
        // snapshots) with it, and that history cannot be rebuilt — a snapshot
        // only exists where somebody changed something on the day they changed it.
        allow delete: if canManage(lid, 'foodcost');

        // ── What this product cost, and earned, on a given day ─────────────
        // APPEND-ONLY, exactly like the ingredient price history and for the same
        // reason: it is the series a margin over time is rebuilt from, and one
        // that can be rewritten afterwards answers nothing.
        //
        // ⚠️ A SUBCOLLECTION INHERITS NOTHING from the rules of the document above
        // it. Without this block every write here is refused by the default-deny
        // at the bottom of the file, and from the app that looks like a network
        // problem.
        //
        // The frozen VAT rate is required, not optional: it is the whole reason a
        // past margin stays comparable after a rate changes by law.
        match /snapshots/{snapshotId} {
          allow read: if canManage(lid, 'foodcost');

          allow create: if canManage(lid, 'foodcost')
            && stampedFor(lid)
            && request.resource.data.keys().hasOnly([
                 'bakery', 'recordedAt', 'unitCost', 'foodCostPct',
                 'sellingPrice', 'vatRate', 'sellingMode', 'frozenPrices'
               ])
            && request.resource.data.recordedAt is string
            && request.resource.data.recordedAt.size() > 0
            && request.resource.data.recordedAt.size() <= 64
            && request.resource.data.unitCost is number
            && request.resource.data.unitCost >= 0
            && request.resource.data.foodCostPct is number
            && request.resource.data.foodCostPct >= 0
            && request.resource.data.sellingPrice is number
            && request.resource.data.sellingPrice > 0
            && request.resource.data.vatRate is number
            && request.resource.data.vatRate >= 0
            && request.resource.data.vatRate <= 100
            && request.resource.data.sellingMode in ['piece', 'weight']
            && request.resource.data.frozenPrices is map
            && request.resource.data.frozenPrices.size() <= 500;

          allow update, delete: if false;
        }
      }

      // ── Pastries to prove ───────────────────────────────────────────────
      // SEVEN documents, for ever: one per weekday, the id being the
      // capitalised English weekday name — the same vocabulary
      // suppliers.orderDays uses. The id is pinned to that list, so this
      // collection can never grow a document that means nothing.
      //
      // A LIST rather than a pattern, because the set is small, closed and
      // worth reading at a glance — not because a pattern would be unsafe.
      // ⚠️ An earlier version of this comment claimed matches() is unanchored
      // and would accept 'xMondayx'. THAT IS WRONG, and it was corrected after
      // probing the emulator directly: matches() compares the WHOLE string, so
      // an unanchored '[0-9]{4}-[0-9]{2}-[0-9]{2}' still refuses
      // 'xx2026-08-05xx'. Anchors here are belt and braces, not the guard.
      //
      // Written WHOLE (setDoc, no merge), so — unlike suppliers, ingredients
      // and drafts — the keys can be REQUIRED rather than all optional. That
      // is safe HERE AND ONLY HERE: this is a brand-new collection, so there
      // is no phone still running an older writer whose payload would suddenly
      // start being refused. Never copy this shape onto a collection that
      // production already carries.
      //
      // `day` repeats the document id and is pinned equal to it, so the field
      // and the folder can never disagree — the same reasoning as the `bakery`
      // stamp one line below it.
      //
      // ⚠️ RULES CANNOT LOOK INSIDE A LIST, so the shape of each row
      // ({ name, qty }), the length of a name and the size of a quantity are
      // guaranteed by js/pastries/pastries-model.js and NOT by this file. What
      // is enforced here is the list's SIZE, which is what keeps the document
      // far away from the 1MB ceiling.
      //
      // No delete: emptying a day is `items: []`, an ordinary update. There is
      // nothing a delete does here that an update does not, so the destructive
      // verb is simply not reachable from a phone.
      match /pastries/{day} {
        allow read: if canUse(lid, 'pastries');
        allow create, update: if canUse(lid, 'pastries')
          && day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
          && request.resource.data.keys().hasOnly(['bakery', 'day', 'items', 'updatedAt', 'note'])
          && stampedFor(lid)
          && request.resource.data.day == day
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100
          // ⚠️ `note` IS OPTIONAL, AND BOTH DIRECTIONS MATTER. Rules reach every
          // phone the instant they deploy; code arrives per device. Required, and
          // every phone still on the previous version would have every save
          // refused — silently, permanently, with nothing on screen to explain
          // it. Absent from the whitelist, and every UPDATED phone would be
          // refused instead. Optional, deployed BEFORE the code merges, is the
          // only ordering that is safe in both directions. Same precedent as
          // orders-history.names above.
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 500))
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64;
        allow delete: if false;
      }

      // ── A night's proving, kept as a record ─────────────────────────────
      // One document per work DATE per weekday list: 2026-08-05_Wednesday.
      // Accepting twice in one night replaces the record rather than adding a
      // second, so the collection holds at most one document per night.
      //
      // The id is pinned to the two fields it is composed from, so the folder
      // and the fields can never disagree — the same reasoning as `day == day`
      // above, and it is what makes the date and weekday checks below govern the
      // id as well. The weekday half is a LIST because the set is closed and
      // short; the date half is a pattern because it is not.
      //
      // Written WHOLE, so the keys can be REQUIRED — safe here because the
      // collection is new and no phone anywhere writes an older shape. `note`
      // is the one exception: it is optional, because a day that never had a
      // standing note produces a record without one.
      //
      // ⚠️ NOTHING DELETES A RECORD BY ITSELF, AND THAT IS NOT ENFORCED HERE.
      // The app removes a record only when a person taps the bin; the fifteen
      // days on the Records screen are a DISPLAY window and take nothing away.
      // These rules cannot tell one delete from another, so `allow delete` below
      // is deliberately open to any member — refusing it would remove the only
      // way to undo a record typed by mistake. Written here so nobody reads a
      // retention guarantee into a rule that cannot make one.
      match /pastry-logs/{id} {
        allow read: if canUse(lid, 'pastries');
        allow create, update: if canUse(lid, 'pastries')
          && stampedFor(lid)
          && id == request.resource.data.date + '_' + request.resource.data.day
          && request.resource.data.keys().hasOnly(
               ['bakery', 'date', 'day', 'items', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.day in
               ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 500))
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 64
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64;
        allow delete: if canUse(lid, 'pastries');
      }

      // ── Notifications that arrive with the app closed ────────────────
      //
      // Two collections, both written by a phone about ITSELF and read only by
      // the server (which uses the Admin SDK and bypasses these rules entirely).
      //
      // ⚠️ NEITHER IS REACHABLE BY AN ORDERING CLIENT, and not because a rule
      // here remembers to ask. member() requires a users/{uid} document, an
      // ordering account has none, so every rule below refuses it by
      // construction. That is the property to preserve: safety comes from the
      // client being invisible to the staff rules, not from each rule carrying
      // an exception.
      //
      // ⚠️ NOT gated on any section. A notification is not a screen — the timers
      // come from the Catalogue and the order alerts from the Calculator, and a
      // venue that switches one off must not thereby lose the other's alerts, or
      // worse, be left with a token nothing can ever clean up.

      // Which phone may receive notifications for this location. The document id
      // IS the device token; there is one per device, replaced when it rotates.
      //
      // ⚠️ `uid` MUST BE THE WRITER'S OWN. Without that a member could register a
      // token belonging to somebody else and quietly redirect this location's
      // alerts to another phone. The delete branch checks the STORED uid, because
      // a delete carries no request.resource.
      match /fcm-tokens/{token} {
        allow read: if member(lid);
        allow create, update: if member(lid)
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly(['bakery', 'uid', 'updatedAt', 'muteOrderRequests'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.updatedAt is number
          // ⚠️ "DO NOT BUZZ ME ABOUT ORDER LISTS." A preference of THIS PHONE, which is
          // why it lives on the phone's own token document rather than on the person:
          // somebody may want the alert on the phone in their pocket and not on the
          // tablet in the kitchen. It is also the document the server already reads to
          // decide who to send to, so it costs no extra read.
          //
          // ⚠️ SILENCING THE BUZZ NEVER SILENCES THE WORK. The coloured card and the
          // banner stay whatever this says — somebody coming back must not find an app
          // that looks empty. Same rule as the holiday switch.
          //
          // ⚠️ OPTIONAL IN BOTH DIRECTIONS, like every field here: rules reach every
          // phone the instant they deploy while code arrives one device at a time.
          && (!('muteOrderRequests' in request.resource.data)
              || request.resource.data.muteOrderRequests is bool);
        allow delete: if member(lid) && resource.data.uid == request.auth.uid;
      }

      // ── "I am on holiday: do not buzz my phone" ─────────────────────────
      //
      // One document per person, written only by that person. Same shape and the
      // same reason as fcm-tokens beside it: it is a fact about MY phone, and
      // nobody else has any business setting it.
      //
      // ⚠️ IT IS READABLE BY EVERYONE IN THE LOCATION, ON PURPOSE. The screen
      // that sends an order list has to be able to say "nobody will be told —
      // they are all away" BEFORE the list goes, and it cannot say that without
      // reading who is away. There is nothing private in it: a date, and a
      // colleague being on holiday is not a secret in a kitchen.
      //
      // ⚠️ A DATE, NOT A BOOLEAN, AND THE RULES REQUIRE THE SHAPE. A switch with
      // no end is one flicked in August and found in November; storing a bare
      // true/false would make that the normal case rather than an impossible one.
      // An EMPTY string is "I am back" and is deliberately legal — see the model.
      match /away/{uid} {
        allow read: if member(lid);

        allow create, update: if member(lid)
          && stampedFor(lid)
          // ⚠️ ONLY ABOUT YOURSELF. Without this, anybody in the venue could
          // silence the manager's phone — the exact opposite of what this is for,
          // and invisible from every screen.
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['bakery', 'uid', 'until', 'updatedAt'])
          && request.resource.data.until is string
          && (request.resource.data.until == ''
              || request.resource.data.until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && request.resource.data.updatedAt is number;

        allow delete: if member(lid) && uid == request.auth.uid;
      }

      // A single scheduled alarm: send this text to this phone at this instant.
      //
      // ⚠️ THE UPDATE BRANCH IS DELIBERATELY NARROW. Cancelling is the whole point
      // of this collection, so an update may change `active` and nothing else —
      // it cannot move `fireAt` (retiming somebody's alarm), repoint `token`
      // (sending it to another phone) or rewrite the text. Everything else is
      // pinned to what is already stored.
      //
      // ⚠️ A CANCELLED TIMER IS KEPT, NOT DELETED. The server re-reads this
      // document an instant before sending; if cancelling deleted it, a read that
      // failed for any other reason would look identical to "cancelled" and the
      // two would be impossible to tell apart in a log.
      match /push-timers/{id} {
        allow read: if member(lid);
        allow create: if member(lid)
          && stampedFor(lid)
          && request.resource.data.keys().hasOnly(
               ['bakery', 'uid', 'token', 'fireAt', 'title', 'body', 'active', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.fireAt is number
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 160
          && request.resource.data.active == true
          && request.resource.data.createdAt is number;
        allow update: if member(lid)
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active is bool;
        allow delete: if member(lid) && resource.data.uid == request.auth.uid;
      }
    }

    // The OLD FLAT COLLECTIONS (suppliers/…, ingredients/…, config/…) are gone
    // from this file. Their documents still exist — nothing was deleted, and they
    // remain the way back if the move ever has to be undone — but the catch-all
    // below now refuses every client that asks for them. Only the Firebase console,
    // which bypasses rules, can still read them.

    // Default deny: any collection not explicitly matched above is locked down,
    // so adding a new collection can never accidentally inherit open access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
